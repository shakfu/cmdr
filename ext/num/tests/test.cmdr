# Each line must succeed; cmdr stops at the first that fails.
num-seq 1 5 | join , | equals 1,2,3,4,5
num-seq 10 0 -5 | join , | equals 10,5,0
num-seq 5 1 | empty
num-seq 0 0.3 0.1 | count | equals 4
num-seq 1 3 | each { mul 2 } | join , | equals 2,4,6
num-range 3 | join , | equals 1,2,3
num-range 0 | empty
num-mod 7 3 | equals 1
num-mod -1 3 | equals 2
num-mod 1 -3 | equals -2
num-mod 5.5 2 | equals 1.5
num-floor -1.5 | equals -2
num-ceil -0.5 | equals 0
num-round 2.5 | equals 3
num-round -2.5 | equals -3
num-abs -4 | equals 4
