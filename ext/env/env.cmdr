# The env module: import env. C commands come from _env; as names a
# re-export that shadows a built-in name, which from otherwise refuses.
from _env import get
def path-dirs { () get PATH | split : | keep { nonempty } } "List the directories in PATH"
# Last, since it shadows the primitive or, which it calls.
def or { (name fallback) or { () get $name } $fallback } "Return variable NAME, or FALLBACK if unset"
