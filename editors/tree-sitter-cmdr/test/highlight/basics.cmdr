def wrap { (x d=- _) text $d $x $d } "Wrap X in D"
# <- keyword.function
#   ^ function
#        ^ punctuation.bracket
#           ^ variable.parameter
#               ^ constant
#                    ^ function.call
#                         ^ variable
#                                    ^ string
list a b | map wrap 2 'q' "a\tb" | join ,
