{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cmdr",
  "scopeName": "source.cmdr",
  "fileTypes": [
    "cmdr"
  ],
  "patterns": [
    {
      "include": "#line"
    }
  ],
  "repository": {
    "line": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#block"
        },
        {
          "include": "#definition"
        },
        {
          "include": "#command"
        },
        {
          "include": "#argument"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.cmdr",
      "match": "^\\s*#.*$"
    },
    "definition": {
      "match": "(?:^|(?<=^[|{])|(?<=[^\\\\][|{]))\\s*(def)(?=\\s|$)(?:\\s+([^\\s|{}()'\"$\\\\]+))?",
      "captures": {
        "1": {
          "name": "keyword.other.def.cmdr"
        },
        "2": {
          "name": "entity.name.function.cmdr"
        }
      }
    },
    "command": {
      "match": "(?:^|(?<=^[|{])|(?<=[^\\\\][|{]))\\s*([^\\s|{}()'\"$\\\\]+)",
      "captures": {
        "1": {
          "name": "entity.name.function.call.cmdr"
        }
      }
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.cmdr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.cmdr"
        }
      },
      "name": "meta.block.cmdr",
      "patterns": [
        {
          "match": "\\G\\s*(\\()([^)]*)(\\))(?:\\s*([^\\s|{}()'\"$\\\\]+))?",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.cmdr"
            },
            "2": {
              "patterns": [
                {
                  "match": "(=)([^\\s)]*)",
                  "captures": {
                    "1": {
                      "name": "keyword.operator.assignment.cmdr"
                    },
                    "2": {
                      "name": "constant.other.cmdr"
                    }
                  }
                },
                {
                  "match": "[A-Za-z][A-Za-z0-9_-]*|\\b_\\b",
                  "name": "variable.parameter.cmdr"
                }
              ]
            },
            "3": {
              "name": "punctuation.definition.parameters.end.cmdr"
            },
            "4": {
              "name": "entity.name.function.call.cmdr"
            }
          }
        },
        {
          "include": "#line"
        }
      ]
    },
    "argument": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.cmdr",
          "match": "\\|"
        },
        {
          "include": "#sub"
        },
        {
          "name": "variable.other.reference.cmdr",
          "match": "\\$[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*"
        },
        {
          "name": "string.quoted.single.cmdr",
          "match": "'[^']*'"
        },
        {
          "name": "string.quoted.double.cmdr",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.cmdr",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.escape.cmdr",
          "match": "\\\\."
        },
        {
          "name": "constant.numeric.cmdr",
          "match": "(?<![^\\s])-?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?(?![^\\s|})])"
        }
      ]
    },
    "sub": {
      "begin": "\\$\\(",
      "end": "\\)",
      "name": "meta.group.sub-pipeline.cmdr",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.cmdr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.cmdr"
        }
      },
      "patterns": [
        {
          "match": "\\G\\s*([^\\s|{}()'\"$\\\\]+)",
          "captures": {
            "1": {
              "name": "entity.name.function.call.cmdr"
            }
          }
        },
        {
          "include": "#paren"
        },
        {
          "include": "#line"
        }
      ]
    },
    "paren": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#paren"
        },
        {
          "include": "#line"
        }
      ]
    }
  }
}
