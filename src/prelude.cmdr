# Commands composed from the primitives. The build embeds this file, and
# cmdr runs it at startup. Each def sees only the commands above it.
# Definitions that read files or run programs go in prelude-effects.cmdr.

# Lists
# fold returns an item as it is; join would reject a list item.
def first { nonempty | head 1 | fold "" { (_ x) $x } } "Return the first item"
def last { nonempty | tail 1 | fold "" { (_ x) $x } } "Return the last item"
def nth { (xs n) gt $n 0 | le $(count $xs) | $xs | head $n | last } "Return item N, counting from 1"
def init { (xs) head $xs $(nonempty $xs | count | sub 1) } "Drop the last item"
def rest { (xs) tail $xs $(nonempty $xs | count | sub 1) } "Drop the first item"
def unlines { join "\n" } "Join text items with newlines"
def unwords { join " " } "Join text items with spaces"
def distinct { sort | uniq } "Sort and remove duplicates"
def reject { (xs t) keep $xs { not { contains $t } } } "Drop items containing TEXT"
def without { (xs t) keep $xs { not { equals $t } } } "Drop items equal to TEXT"
def compact { keep { trim | nonempty } } "Drop blank items"
def prefix { (xs t) each $xs { (s) concat $t $s } } "Prepend TEXT to each item"
def suffix { (xs t) each $xs { (s) concat $s $t } } "Append TEXT to each item"
def empty { not { nonempty } } "Return VALUE if empty text or list"
def any { (xs b) keep $xs $b | nonempty | $xs } "Return LIST if the block holds for some item"
def all { (xs b) keep $xs { (x) not $x $b } | empty | $xs } "Return LIST if the block holds for every item"

# Numbers
def sum { fold 0 { (a x) add $a $x } } "Add the items"
def product { fold 1 { (a x) mul $a $x } } "Multiply the items"
def max { (xs) fold $xs $(nonempty $xs | first) { (a x) or $a { gt $x } $x } } "Return the largest number"
def min { (xs) fold $xs $(nonempty $xs | first) { (a x) or $a { lt $x } $x } } "Return the smallest number"
def mean { (xs) sum $xs | div $(count $xs) } "Return the arithmetic mean"
def between { (n lo hi) ge $n $lo | le $hi } "Return NUMBER if within LO and HI"

# Text
def words { replace "\t" " " | replace "\n" " " | split " " | keep { nonempty } } "Split on spaces, tabs, and newlines"
def starts-with { (s x) take $s $(length $x) | equals $x | $s } "Return TEXT if it starts with PREFIX"
def ends-with { (s x) $x | length | with { (b) drop $s $(length $s | ge $b | sub $b) | equals $x } | $s } "Return TEXT if it ends with SUFFIX"
def strip-prefix { (s x) starts-with $s $x | $x | length | with { (n) drop $s $n } } "Remove PREFIX from TEXT"
def strip-suffix { (s x) ends-with $s $x | length | with { (a) $x | length | with { (b) take $s $(sub $a $b) } } } "Remove SUFFIX from TEXT"

# Paths
def path-ext { path-basename | check { drop 1 | contains . } "no extension" | split . | last } "Return the text after the basename's last dot; mismatch if it has none"
def path-has-ext { keep { drop 1 | contains . } } "Keep names with a dot after the first byte"
def path-stem { path-basename | with { (b) or { () drop $b 1 | contains . | $b | split . | init | join . } $b } } "Return the basename without its extension"
def path-join { (base p) or { () ends-with $base / | take 0 } / | with { (s) or { () empty $base } $s } | with { (s) concat $base $s $p } | with { (j) or { () starts-with $p / } $j } } "Join PATH to BASE with one /; an absolute PATH replaces BASE"
def path-split { (p) path-dirname $p | list $(path-basename $p) } "Return the directory and last component of PATH"
