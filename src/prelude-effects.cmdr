# Commands composed from the effect primitives. Sessions with effects run
# this file after prelude.cmdr.

def cat { each { read } | concat } "Concatenate files"
def grep { (file regex) read $file | keep { matches $regex } } "Return lines of FILE matching REGEX"
def sh { (c) run sh -c $c } "Run a shell command, returning stdout"
def sh-in { (text c) run-in $text sh -c $c } "Run a shell command with TEXT on stdin"
