/* cmdr grammar, in W3C EBNF notation: https://www.w3.org/TR/xml/#sec-notation
 *
 * This file and README.md define cmdr's syntax. Where the code disagrees with
 * them, the code has a bug; see docs/dev/stability.md.
 *
 * The rules live in these functions:
 *   src/session.c  cmdr_join        line joining (section 1)
 *   src/cmdr.c     comment_end      comments (section 2)
 *                  parse            pipelines and stages (section 2)
 *                  read_lexeme      words, references, and bracket extents
 *                                   (sections 3 to 5)
 *                  check_reference  references (section 4)
 *                  closing          bracket matching (section 5)
 *                  compile_block    parameter lists (section 5)
 *                  default_length   parameter defaults (section 5)
 *                  scan, cmdr_scan  the same rules, tolerating unfinished
 *                                   input, for joining and highlighting
 *   src/format.c   split            joining and checking for --fmt
 *
 * Parsing has three steps:
 *   1. Line joining groups physical lines into units.
 *   2. Bracket matching finds each block's and sub-pipeline's extent.
 *   3. Each unit is parsed as body. Each extent's text is parsed again: a
 *      block's as block_body, a sub-pipeline's as body.
 * Constraints that EBNF cannot express are listed at the end.
 */

/* ---- 1. Scripts and line joining ------------------------------------- */

/* A script, a loaded file, a module, REPL input, piped stdin, -c text, and
 * --fmt input are physical lines. A NUL byte is an error, "NUL byte", and a
 * script reports it as "PATH:LINE: NUL byte". The last line may lack NL. */
script        ::= ( physical_line NL )* physical_line?
physical_line ::= [^#x0#xA]*

/* Joining (cmdr_join) reads physical lines into a unit. While the unit ends
 * in "|", or a block or sub-pipeline is open outside quotes, the next
 * physical line is appended after a NL; a blank or comment line is dropped
 * there. A quote never spans lines: a unit that ends inside one ends there.
 * Each unit is parsed as body, checked (section 7), and run before the next
 * unit is joined. --fmt checks each unit as joined, without running it. */
unit          ::= body

/* ---- 2. Pipelines ---------------------------------------------------- */

/* A comment is "#" where a line or a body starts: at a line's first non-S
 * character, or after "{", after a block's parameter list on the same line,
 * or after "$(", with only S between. It runs to the end of its line and
 * hides quotes and brackets there, so "{ # x }" on one line leaves the block
 * open. "#" elsewhere is word text: `text a #b` prints "a #b", and in
 * `list a | # x` the second stage calls a command named "#". */
comment       ::= "#" [^#xA]*

/* NL goes only next to "|" or at a body's ends, so a missing "|" is an
 * error, not an argument. */
gap           ::= ( S | NL | NL S* comment )*
body          ::= S* comment? gap ( pipeline gap )?
pipeline      ::= stage ( gap "|" gap stage )*

/* A stage of one reference returns that value. Otherwise the first lexeme is
 * the command name and must be a word. */
stage         ::= reference
                | word ( S+ argument )*

argument      ::= word | reference | block | sub_pipeline

/* ---- 3. Words -------------------------------------------------------- */

/* A word runs to the next unquoted WS or "|". Pieces concatenate:
 * a"b c"d is the one word "ab cd". */
word          ::= ( piece - ( "{" | "$" ) ) piece*
piece         ::= bare | escape | sq_string | dq_string

/* "$", "{", "}", "(", ")", and "#" are ordinary after a word's first
 * character: at the top level, a$x, a{b, and x) are literal words. Inside a
 * block or sub-pipeline, bracket matching (section 5) counts every unquoted
 * "{" and "$(", so a{b there opens a block. "}" and ")" end a word only
 * where they close an enclosing block or sub-pipeline. */
bare          ::= [^#x0 #x9#xA#xB#xC#xD|'"\]

/* Outside quotes, \c is c: \n is "n". A "\" before NL or at the end of the
 * text is an error, "unfinished escape": there is no line continuation. */
escape        ::= "\" ( Char - NL )

/* Single quotes keep every character, including "\". */
sq_string     ::= "'" [^'#x0#xA]* "'"

/* In double quotes, \n is a newline, \t a tab, and \c is c otherwise. */
dq_string     ::= '"' ( [^"\#x0#xA] | "\" ( Char - NL ) )* '"'

/* Every word is text. Numbers have no lexical class; commands parse them. */

/* ---- 4. References --------------------------------------------------- */

/* The reference lexeme runs from "$" to the next WS or "|", and all of it
 * must match: $x. and $x"y" are errors, not a reference and text. */
reference     ::= "$" identifier ( "." identifier )*
identifier    ::= [A-Za-z] [A-Za-z0-9_-]*

/* ---- 5. Blocks ------------------------------------------------------- */

/* A closing "}" or ")" must be followed by WS, "|", or the end of the
 * enclosing text: {a}b and $(a)b are errors. */
block         ::= "{" brace_text "}"
sub_pipeline  ::= "$(" paren_text ")"

/* Bracket matching (closing). Blocks and sub-pipelines nest together: inside
 * either, each "{" and "$(" opens a level, and the innermost level's "}" or
 * ")" closes it. Where "$(" could also be "$" then "(", it opens a
 * sub-pipeline. Quotes, escapes, and comments hide brackets; a comment is
 * recognised only where section 2 allows one.
 *
 * Inside a sub-pipeline, plain "(" and ")" nest too, so $(text (a)) passes
 * "(a)" to text. Inside a block they are text, so a ")" in a block in a
 * sub-pipeline does not close the sub-pipeline. Each text is then parsed:
 * brace_text as block_body, paren_text as body. */
brace_text    ::= ( [^{}'"\] | escape | sq_string | dq_string | comment
                  | block | sub_pipeline )*
paren_text    ::= ( [^(){}'"\] | escape | sq_string | dq_string | comment
                  | "(" paren_text ")" | block | sub_pipeline )*

/* A "(" that is the first non-WS character of a block opens its parameter
 * list. The body may follow ")" directly: {(x)text $x}. */
block_body    ::= WS* parameters? body
parameters    ::= "(" WS* ( parameter ( WS+ parameter )* WS* )? ")"
parameter     ::= "_"
                | identifier ( "=" default )?

/* A default is literal: "" or '' for empty text, else bare characters. */
default       ::= '""' | "''" | [^ #x9#xA#xB#xC#xD'"\|${})]+

/* ---- 6. Terminals ---------------------------------------------------- */

WS            ::= S | NL                /* C isspace */
S             ::= [ #x9#xB#xC#xD]       /* WS but NL */
NL            ::= #xA
Char          ::= [#x1-#xFF]            /* any byte except NUL */

/* ---- 7. Constraints checked after parsing ---------------------------- *
 *
 * All are checked for the whole unit before any of its commands runs.
 * cmdr_check_syntax, and so --fmt, checks those marked [S]. Only evaluation
 * checks those marked [E], since they need the session's names.
 *
 * - [S] A command name is a word. A block, reference, or sub-pipeline
 *   cannot be one.
 * - [E] A command name names a known command.
 * - [E] A literal COMMAND word of map, in the unit or its sub-pipelines,
 *   names a known command. Inside a block it is resolved when map runs,
 *   since a def's body may name a command defined later.
 * - [S] A sub-pipeline holds a stage: $( # x NL ) is an error, "empty
 *   sub-pipeline $()".
 * - [S] $_ is an error.
 * - [E] A reference names an enclosing block's parameter or a value binding.
 * - [S] Parameters: the first has no default; parameters with defaults follow
 *   all required ones; _ has no default.
 * - [S] A name appears once in a parameter list: "parameter $x is declared
 *   twice". _ may repeat. An inner block may declare an outer block's name,
 *   which it then shadows.
 * - [E] Every parameter but _ is referenced in its body.
 * - [E] as and def do not run while a block runs: as a stage, through map, or
 *   in a sub-pipeline. "as cannot run inside a block; bind names at the top
 *   level".
 * - [S] Blocks and sub-pipelines nest at most 127 deep, counted together;
 *   plain parentheses do not count. Deeper is an error, "blocks and
 *   sub-pipelines nested too deeply".
 */
