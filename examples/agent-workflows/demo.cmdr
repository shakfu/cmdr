#!/usr/bin/env cmdr
# Fix a reported bug in a sample project with a coding agent.
#
#   cmdr demo.cmdr                  dry run: each step prints its prompt
#   cmdr demo.cmdr claude:sonnet    every step runs claude with sonnet
#
# sample/ is copied into a fresh git repository under AW_RUNS (default
# agent-runs/ in the current directory), so agents never touch your files.

import aw

script-args | or { first } dry | as demo-agent "AGENT[:MODEL] from the command line, or dry"
aw.runs-dir | fs-mkdir | path-join demo-project | as demo-dir "The copy of sample/"
def run-in-demo { (args) list dir $demo-dir | with { (o) run-with $o $args } | aw.agent-out } "Run the argv ARGS in the copy; return stdout"
def demo-reset { () run rm -rf $demo-dir | $demo-dir | with { (x) script-dir | path-join sample | with { (s) run cp -R $s $x } } | $demo-dir } "Replace the copy with sample/"
def demo-commit { () list "init -q" "add -A" "commit -q -m 'sample project'" "log --oneline" | each { (c) shlex-split $c | with { (args) list git -c user.name=demo -c user.email=demo@example.invalid $args | run-in-demo } } | last } "Commit the copy; return the log"

# 1. Copy sample/ and commit it, so git shows what the agent changes.
demo-reset
demo-commit

# 2. Ask about the project. ask is read-only: the agent cannot edit files.
demo-dir | aw.target-path | with { (t) aw.ask $t $demo-agent "Summarize this project in three lines." }

# 3. Fix the bug in BUG.md: write a failing test, find the cause, patch it,
#    and review the patch. One agent runs every step.
list @ $demo-agent | concat | with { (at) list reproduce diagnose patch review | suffix $at } | with { (steps) path-join $demo-dir BUG.md | read | aw.target-bug $demo-dir | with { (t) aw.workflow $t bug $steps } }

# 4. What changed, and do the tests pass?
shlex-split "git status --short" | run-in-demo | or { nonempty } "(no changes)"
list dir $demo-dir | with { (o) run-with $o python3 -m unittest -q } | nth 1 | with { (s) list "tests: exit status " $s | concat }

# 5. The run logs, one per ask or chain, with every prompt and output.
aw.runs-dir | files | sort | tail 2
