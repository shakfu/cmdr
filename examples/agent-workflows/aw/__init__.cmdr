# Agent workflows: run coding agents on a target, as one prompt or a chain
# of steps. `import aw` binds these definitions as aw.NAME; see ../README.md.
# Needs the env, fs, re, and time extensions.

import env
import fs
import re
import time

script-dir | as home-dir "Directory holding actions/"
def runs-dir { () env.or AW_RUNS agent-runs } "Directory for run logs"
def agent-timeout { () env.or AW_TIMEOUT 1800 } "Seconds an agent may run"

# Agents. An adapter takes PROMPT DIR MODEL MODE and returns the agent's
# final text. An empty MODEL selects the agent's default; MODE is read or write.
# Each runs in its agent's own sandbox, so agents without one are not here.
def opt { (f v) or $v { (x) list $f $(nonempty $x) } $(list) } "Return FLAG VALUE as a list, or an empty list if VALUE is empty"
def by-mode { (mode r w) or { () equals $mode read | $r } $w } "Return R for read mode, else W"
def agent-out { (res) nth $res 1 | with { (s) nth $res 3 | lines | tail 20 | unlines | with { (e) check $s { equals 0 } $(format "failed with status {}:\n{}" $s $e) } } | $res | nth 2 } "Return stdout of a run-with result, or fail with its stderr"
def launch { (args d) agent-timeout | with { (t) list dir $d timeout $t | run-with $args } | agent-out } "Run ARGS in DIR with the agent timeout"
text '{"sandbox":{"enabled":true,"autoAllowBashIfSandboxed":true,"allowUnsandboxedCommands":false,"failIfUnavailable":true}}' | as claude-sandbox "Settings for claude: Bash may write only in DIR, and never retries unsandboxed"
def sandbox-probe { () list bwrap --unshare-net --ro-bind / / --dev /dev true | with { (p) run uname | trim | with { (os) or { () equals $os Linux | $p } $(list) } } } "An argv that fails where claude's sandbox cannot run commands; empty off Linux"
def check-sandbox { (args) list 0 "" "" | with { (ok) list | with { (o) or $args { (a) run-with $o $(nonempty $a) } $ok } } | with { (r) nth $r 3 | trim | with { (e) nth $r 1 | check { equals 0 } $(concat "sandbox unavailable: " $e) } } } "Fail with ARGS's stderr unless it exits 0; pass if ARGS is empty"
def agent-claude { (p d m mode) sandbox-probe | check-sandbox | $m | with { (x) opt --model $x } | with { (mf) list claude -p $mf --permission-mode $(by-mode $mode plan acceptEdits) --permission-prompts none --safe-mode --settings $claude-sandbox $p | launch $d } } "Run claude -p in its sandbox, without user CLAUDE.md"
def agent-codex { (p d m mode) list codex exec $(opt -m $m) -s $(by-mode $mode read-only workspace-write) $p | launch $d } "Run codex exec"
def agent-cursor { (p d m mode) list cursor-agent -p --output-format text --sandbox enabled $(opt --model $m) $(by-mode $mode --mode=plan --force) $p | launch $d } "Run cursor-agent -p"
def llama-url { () env.or AW_LLAMA_URL http://127.0.0.1:8080 } "Base URL of llama-server"
def llama-max { () env.or AW_LLAMA_MAX_BYTES 200000 } "Largest project text sent to llama"
def llama-file { (d f) format "### {}\n```\n{}\n```" $f $(path-join $d $f | try { read } "(unreadable)") }
def llama-context { (d) list dir $d | run-with git ls-files | agent-out | lines | each { (f) llama-file $d $f } | join "\n\n" | with { (c) llama-max | with { (n) check $c { length | le $n } "project exceeds AW_LLAMA_MAX_BYTES" | $c } } } "Every tracked file in DIR, under a heading"
text "\n\nGive each change as an edit block: the file path alone on a line, then\n<<<<<<< SEARCH\nlines copied exactly from the file\n=======\nthe lines that replace them\n>>>>>>> REPLACE\nSEARCH must match exactly one place in the file. An empty SEARCH creates a new file." | as llama-format
def llama-rule { (mode) text "\n\nYou cannot run commands. Do not claim results you have not seen." | concat $(by-mode $mode "" $llama-format) }
def llama-run { (args x) agent-timeout | with { (t) list stdin $x timeout $t | run-with $args } | agent-out } "Run ARGS with stdin X; return stdout"
def llama-chat { (q m) list jq -c -R -s --arg m $m '{messages: [{role: "user", content: .}]} + (if $m == "" then {} else {model: $m} end)' | llama-run $q | with { (body) llama-url | concat /v1/chat/completions | with { (u) list curl -sS --fail-with-body -H "content-type: application/json" --data-binary @- $u | llama-run $body } } | with { (r) list jq -r ".choices[0].message.content" | llama-run $r } } "Send Q to llama-server; return the reply"

# Edit blocks: PATH, then SEARCH lines that must occur once in PATH, then their
# replacement. Blocks apply to a staging copy; DIR changes only if all apply.
text '^$|^/|/$|//|(^|/)[.][.]?(/|$)|(^|/)[.]git(/|$)' | as edit-unsafe "Paths an edit may not name"
def edit-path-of { (c) split $c "<<<<<<< SEARCH\n" | first | lines | keep { not { starts-with "```" } } | keep { (l) trim $l | nonempty } | last | re.replace '^ *#+ +|[`*]' "" | trim | check { matches '^[^ ]+$' } "a file path" } "The path on the last line before C's SEARCH marker"
def edit-blocks { (r) split $r ">>>>>>> REPLACE" | with { (xs) head $xs $(count $xs | sub 1) } | map replace "<<<<<<< SEARCH\n=======\n" "<<<<<<< SEARCH\n\n=======\n" | fold $(list) { (acc c) or { () last $acc | edit-path-of } $(text "") | concat "\n" $c | with { (fixed) try { () edit-path-of $c | $c } $fixed } | with { (x) push $acc $x } } } "Each edit block in R, without its REPLACE marker; one without a path gets the previous block's"
def edit-infer { (d o) nonempty $o | $o | with { (x) format "\n{}\n" $x } | with { (o1) list dir $d | with { (op) run-with $op git ls-files } | agent-out | lines | keep { (f) path-join $d $f | try { read } "" | with { (x) concat "\n" $x } | contains $o1 } } | with { (fs) count $fs | check { equals 1 } "one file" | $fs | first } } "The one tracked file in DIR holding the SEARCH lines O"
def edit-parse { (d c) split $c "<<<<<<< SEARCH\n" | with { (ps) count $ps | check { equals 2 } "one SEARCH" | $ps | nth 2 | split "\n=======\n" | with { (on) count $on | check { equals 2 } "one divider" | $on | with { (x) nth $x 1 | with { (o) nth $x 2 | with { (n) try { () edit-path-of $c } "" | with { (p0) try { () equals $p0 "" | $d | edit-infer $o } $p0 } | with { (p) text "no file path before SEARCH, and its lines are not in exactly one tracked file" | with { (m) or { () equals $p "" | $m } "" } | with { (r) list $p $o $n $r } } } } } } } } "PATH SEARCH REPLACE and why the block cannot apply; a missing PATH is the one tracked file holding SEARCH"
def edit-prefixes { (p) split $p / | fold $(list) { (acc c) push $acc $(or { () last $acc | path-join $c } $c) } } "a, a/b, a/b/c for a/b/c"
def edit-link { (d x) list | run-with test -L $(path-join $d $x) | nth 1 | check { not { equals 0 } } "a symbolic link" } "Fail if X in DIR is a symbolic link"
def edit-safe { (d p) edit-unsafe | with { (re) check $p { not { matches $re } } "unsafe path" } | $p | edit-prefixes | each { (x) edit-link $d $x } } "Fail unless P is relative, inside DIR, outside .git, and free of symbolic links"
def edit-source { (d stage p) path-join $stage $p | with { (s) or { () fs.exists $s } $(path-join $d $p) } } "P's staged copy if any, else P in DIR"
def edit-why-new { (st) nth $st 1 | with { (src) text "" | with { (ok) nth $st 3 | concat " exists; copy SEARCH lines from it" | with { (m) try { () not $src { fs.exists } | $ok } $m } } } }
def edit-why-old { (st) nth $st 1 | with { (src) nth $st 2 | with { (o1) text "" | with { (ok) nth $st 3 | with { (p) concat "SEARCH must match exactly one place in " $p | with { (ms) or { () fs.exists $src | $ms } $(concat "no such file: " $p) } | with { (m) try { () concat "\n" $(read $src) | with { (cur) length $cur | sub $(replace $cur $o1 "" | length) } | with { (k) length $o1 | equals $k } | $ok } $m } } } } } }
def edit-why { (d stage p o) edit-source $d $stage $p | list $(format "\n{}\n" $o) $p | with { (st) text edit-why-new | with { (cr) or { () equals $o "" | $cr } edit-why-old } | with { (c) list $st | map $c | concat } } } "Empty text if SEARCH O applies to P, else the reason"
def edit-put { (d stage p o n) edit-source $d $stage $p | with { (src) try { () read $src } "" } | with { (cur) concat "\n" $cur | replace $(format "\n{}\n" $o) $(concat "\n" $n) | drop 1 | with { (mod) or { () equals $o "" | $n } $mod } } | with { (x) path-join $stage $p | with { (dst) path-dirname $dst | fs.mkdir | $x | write $dst } } } "Write P's edited text to the staging copy"
def edit-stage { (d stage c) try $c { (x) edit-parse $d $x } { (err) list "" "" "" $(format "malformed edit block ({}): expected a file path alone on a line, SEARCH, =======, and REPLACE" $err) } | with { (e) nth $e 1 | with { (p) nth $e 2 | with { (o) nth $e 3 | with { (n) nth $e 4 | with { (r1) text "" | with { (ok) try { () edit-safe $d $p | $ok } $(concat "unsafe path: " $p) } | with { (r2) list $r1 $r2 $(try { () edit-why $d $stage $p $o } "unreadable") | keep { nonempty } | or { first } "" | with { (why) or { () equals $why "" | $d | edit-put $stage $p $o $n | $why } $why } } } } } } } } "Stage edit block C for DIR; return empty text, or why it failed"
def edit-commit { (d stage) concat $stage / | with { (pre) run find $stage -type f | lines | each { (f) path-join $d $(strip-prefix $f $pre) | with { (dst) path-dirname $dst | fs.mkdir | $f | read | write $dst } } } } "Copy the staging copy into DIR"
def edit-apply { (r d) runs-dir | fs.mkdir | path-join llama-stage-XXXXXX | with { (t) run mktemp -d $t | trim } | with { (stage) edit-blocks $r | with { (bs) count $bs | with { (k) text "" | with { (ok) try { () gt $k 0 | $ok } "no edit blocks" } } | with { (r0) each $bs { (c) edit-stage $d $stage $c } | push $r0 | keep { nonempty } | unlines } } | with { (why) or { () equals $why "" | $d | edit-commit $stage | $stage | with { (x) run rm -rf $x } | $why } $why } } } "Apply R's edit blocks in DIR, then delete the staging copy; return empty text, or why none were applied"

# A llama state is a list of text: PROMPT DIR MODEL, then REPLY and why its
# edits failed, empty if they applied.
def llama-read { (st) nth $st 1 | llama-chat $(nth $st 3) } "Return the reply"
def llama-done { (st) nth $st 4 } "Return the applied reply"
def llama-retry { (st) format "{}\n\nYour previous reply:\n{}\n\nIts edits were not applied:\n{}\nReply with all edit blocks again, corrected. Copy SEARCH lines exactly from the file." $(nth $st 1) $(nth $st 4) $(nth $st 5) | llama-chat $(nth $st 3) | with { (r) edit-apply $r $(nth $st 2) | with { (e) format "edits not applied:\n{}\nReply:\n{}" $e $r | with { (msg) check $e { equals "" } $msg } } | $r } } "Ask again with the reasons; apply that reply or fail"
def llama-write { (st) nth $st 1 | llama-chat $(nth $st 3) | with { (r) edit-apply $r $(nth $st 2) | with { (e) push $st $r $e } } | with { (st2) nth $st2 5 | with { (e) text llama-done | with { (ok) or { () equals $e "" | $ok } llama-retry } } | with { (c) list $st2 | map $c | concat } } } "Apply the reply's edits, retrying once with the reasons"
def agent-llama { (p d m mode) llama-context $d | with { (c) llama-rule $mode | with { (rule) format "Project files:\n\n{}\n\n{}{}" $c $p $rule } } | list $d $m | list | map $(by-mode $mode llama-read llama-write) | concat } "Ask llama-server; in write mode apply its edit blocks in DIR"
def agent-dry { (p d m mode) format "[dry {}]\n{}" $(list $mode $d $m | unwords) $p } "Return the prompt instead of running an agent"
list claude codex cursor llama dry | as agents "Known agent names: those with a built-in sandbox, llama, which runs no commands, and dry"
def agent { (name p d m mode) list $p | map $(concat agent- $name) $d $m $mode | concat } "Run agent NAME on PROMPT in DIR"

# Targets: a list of KIND DIR BRIEF. BRIEF opens every prompt.
def target { (kind d b) check $d { fs.is-dir } "not a directory" | with { (x) list $kind $x $b } }
def target-path { (d) text "Target: the project in the working directory." | with { (b) target path $d $b } } "Target the code in DIR"
def target-bug { (r d) concat "Target: a bug in the project in the working directory.\n\nBug report:\n" $r | with { (b) target bug $d $b } } "Target the bug REPORT in DIR"
def target-feature { (s d) concat "Target: a feature for the project in the working directory.\n\nSpecification:\n" $s | with { (b) target feature $d $b } } "Target the feature SPEC in DIR"
def target-kind { (t) nth $t 1 }
def target-dir { (t) nth $t 2 }
def target-brief { (t) nth $t 3 }
def require-kind { (t k) target-kind $t | check { equals $k } "wrong target kind" | $t } "Return TARGET if its kind is KIND"

# Actions: actions/NAME.md. The first line is "mode: read" or "mode: write";
# the rest is a template with {{target}}, {{input}}, and {{history}}.
def action-file { (a) path-join $home-dir actions | path-join $(concat $a .md) }
def action-mode { (a) action-file $a | read | lines | first | strip-prefix "mode: " | check { matches '^(read|write)$' } "mode must be read or write" }
def action-body { (a) action-file $a | read | lines | rest | unlines }

# History: a list of "## STEP" headings, each followed by that step's output.
def history-last { (h) or { () last $h } "(none)" } "The last output, or (none)"
def history-text { (h) join $h "\n\n" }
def render { (tmpl t h) replace $tmpl "{{target}}" $(target-brief $t) | replace "{{input}}" $(history-last $h) | replace "{{history}}" $(history-text $h) }

# Steps: ACTION@AGENT[:MODEL]. A parsed step is the re.groups list:
# spec, action, agent, ":MODEL", MODEL.
text '^([a-z][a-z-]*)@([a-z]+)(:(.+))?$' | as step-re
def parse-step { (s) step-re | with { (re) check $s { matches $re } "expected ACTION@AGENT[:MODEL]" | re.groups $re } }
def step-spec { (p) nth $p 1 }
def step-action { (p) nth $p 2 }
def step-agent { (p) nth $p 3 }
def step-model { (p) nth $p 5 }
def check-step { (p) step-agent $p | with { (n) agents | check { any { equals $n } } "unknown agent" } | $p | step-action | action-file | check { fs.is-file } "unknown action" | $p | step-action | action-mode | $p } "Return STEP if its agent and action exist"
def run-step { (t p h) step-action $p | action-body | render $t $h | with { (q) step-action $p | action-mode | with { (mode) target-dir $t | with { (d) step-model $p | with { (m) step-agent $p | agent $q $d $m $mode } } } } }
def heading { (p) step-spec $p | with { (s) concat "## " $s } }
def log-append { (x log) concat $x "\n\n" | append $log | $x } "Append TEXT and a blank line to LOG"

# Chains. Every step is checked before the first agent runs. Each step gets
# the previous output as {{input}} and every earlier one as {{history}}.
# The log in AW_RUNS records the run; steps do not read it.
def run-log { (t) runs-dir | fs.mkdir | with { (r) time.local "%Y%m%d-%H%M%S" | concat -XXXXXX | with { (n) run mktemp $(path-join $r $n) | trim } } | with { (log) format "# Run\n\n{}\n\n" $(target-brief $t) | write $log | $log } }
def first-history { (input) or $input { (x) list "## input" $(nonempty $x) } $(list) } "History holding INPUT, or empty"
def chain-step { (h t p log) heading $p | log-append $log | with { (head) run-step $t $p $h | log-append $log | with { (out) push $h $head $out } } }
def chain-from { (t specs input) map $specs parse-step | map check-step | with { (steps) run-log $t | with { (log) fold $steps $(first-history $input) { (h p) chain-step $h $t $p $log } } } | history-last } "Run STEPS on TARGET, the first with INPUT; return the last output"
def chain { (t specs) chain-from $t $specs "" } "Run STEPS on TARGET in order; return the last output"
def ask { (t a q) chain-from $t $(concat ask@ $a | list) $q } "Ask AGENT[:MODEL] about TARGET, without edits"
def edit { (t a q) chain-from $t $(concat edit@ $a | list) $q } "Have AGENT[:MODEL] change TARGET as PROMPT says"

# Workflows: a default chain per target kind. Pass other steps to chain.
list survey@claude review@codex report@claude | as audit-steps
list reproduce@claude diagnose@codex patch@claude review@codex | as fix-steps
list plan@claude critique@codex implement@claude verify@codex review@cursor | as build-steps
def workflow { (t kind steps) require-kind $t $kind | chain $steps } "Run STEPS on TARGET if its kind is KIND"
def audit { (t) audit-steps | with { (s) workflow $t path $s } } "Survey, review, and report on a path target"
def fix { (t) fix-steps | with { (s) workflow $t bug $s } } "Reproduce, diagnose, patch, and review a bug target"
def build { (t) build-steps | with { (s) workflow $t feature $s } } "Plan, critique, implement, verify, and review a feature target"
