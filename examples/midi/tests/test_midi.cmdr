# Checks the midi module. CTest runs it as example_midi, with MIDI_OUT set to
# a directory under build/. Random expectations are Python 3.9's for the same
# seed and draws.

import midi

# One namespace: the C commands and the module's definitions are both midi.NAME.
import midi as m
import env
import fs
import random
m.key C4 | equals 60
m.scale C4 | count | equals 7
help m.write | first | equals "m.write SCORE PATH [BPM]"
from midi import bjorklund chord-keys
bjorklund 3 8 | concat | equals 10010010
chord-keys C4 | join , | equals 60,64,67

env.get MIDI_OUT | fs.mkdir | as out-dir "The test directory"
def tmp { (p) out-dir | path-join $p } "Path P in the test directory"

# Items and their fields.
midi.note C4 | join , | equals "note 0 1 60 100 1"
midi.note 61 2 80 3 | join , | equals "note 0 2 61 80 3"
midi.note C4 | first | midi.put 5 90 | equals "note 0 1 60 90 1"
midi.note C4 | first | midi.field 4 | equals 60
midi.cc 7 100 | join , | equals "cc 0 7 100 1"
midi.program 33 2 | join , | equals "program 0 33 2"
midi.bend -8192 | join , | equals "bend 0 -8192 1"
midi.tempo 90 | join , | equals "tempo 0 90"
midi.rest 2 | join , | equals "rest 0 2"
midi.ramp 1 0 127 2 4 | join , | equals "cc 0 1 0 1,cc 0.5 1 32 1,cc 1 1 64 1,cc 1.5 1 95 1,cc 2 1 127 1"

# Building: a . in seq is a rest item. KEYS may be a list or text.
midi.seq "C4 . E4" 0.5 | join , | equals "note 0 0.5 60 100 1,rest 0.5 0.5,note 1 0.5 64 100 1"
list 60 62 | midi.seq | join , | equals "note 0 1 60 100 1,note 1 1 62 100 1"
midi.chord "C4 E4" 2 64 2 | join , | equals "note 0 2 60 64 2,note 0 2 64 64 2"
list | midi.seq | empty
try { () midi.seq "C4 H4" } failed | equals failed

# Rests count toward the end, so then, sequence, and loop keep them.
midi.seq "C4 . ." | midi.end | equals 3
midi.note D4 | midi.then $(midi.seq "C4 .") | midi.end | equals 3
midi.seq "C4 ." | list $(midi.note D4) | midi.sequence | join , | equals "note 0 1 60 100 1,rest 1 1,note 2 1 62 100 1"
midi.seq "C4 ." | midi.loop 2 | join , | equals "note 0 1 60 100 1,rest 1 1,note 2 1 60 100 1,rest 3 1"
midi.note C4 | midi.then $(midi.rest 2) | midi.end | equals 3

# Pitch sets.
midi.scale C4 | join , | equals 60,62,64,65,67,69,71
midi.scale A3 minor 2 | count | equals 14
midi.scale C4 blues | join , | equals 60,63,65,66,67,70
midi.chord-keys D4 min7 | join , | equals 62,65,69,72
midi.scale C4 | midi.degrees "1 3 5" | join , | equals 60,64,67
try { () midi.scale C4 bogus } failed | equals failed

# Rhythm: Bjorklund's patterns, rotated left by ROTATE.
midi.euclid 3 8 x | concat | equals x..x..x.
midi.euclid 5 8 x | concat | equals x.xx.xx.
midi.euclid 3 8 x 1 | concat | equals ..x..x.x
midi.euclid 3 8 x -1 | concat | equals .x..x..x
midi.euclid 3 8 C2 | midi.seq 0.5 | count | equals 8
list | midi.rotate 3 | empty

# Changing a score: each change applies to the kinds that have the field.
midi.seq "C4 D4" | midi.transpose -12 | join , | equals "note 0 1 48 100 1,note 1 1 50 100 1"
midi.seq "C4 . D4" | midi.shift 2 | midi.stretch 0.5 | join , | equals "note 1 0.5 60 100 1,rest 1.5 0.5,note 2 0.5 62 100 1"
midi.seq "C4 D4" | midi.velocity 30 | midi.channel 10 | join , | equals "note 0 1 60 30 10,note 1 1 62 30 10"
midi.cc 7 100 | midi.stack $(midi.program 33) | with { (s) midi.tempo 90 | midi.stack $s } | midi.channel 3 | midi.transpose 5 | join , | equals "tempo 0 90,cc 0 7 100 3,program 0 33 3"
midi.chord "C4 E4" 3 | midi.end | equals 3
list | midi.end | equals 0
midi.note D4 | midi.stack $(midi.note C4) | join , | equals "note 0 1 62 100 1,note 0 1 60 100 1"

# Chance: these match Python's random after the same seed.
random.seed 1
midi.scale C4 | midi.walk 8 | join , | equals 60,60,62,64,62,62,62,62
random.seed 1
midi.scale C4 major 2 | midi.walk 8 3 2 | join , | equals 64,60,64,65,64,64,64,65
random.seed 2
midi.seq "C4 D4 E4 F4 G4 A4" | midi.chance 0.5 | join , | equals "rest 0 1,rest 1 1,note 2 1 64 100 1,note 3 1 65 100 1,rest 4 1,rest 5 1"
random.seed 3
midi.pick "C4 E4 ." 6 0.5 | join , | equals "note 0 0.5 60 100 1,note 0.5 0.5 64 100 1,note 1 0.5 64 100 1,note 1.5 0.5 64 100 1,note 2 0.5 64 100 1,note 2.5 0.5 60 100 1"
random.seed 4
midi.seq "C4 D4" | midi.humanize 0.1 10 | join , | equals "note 0 1 60 93 1,note 1.0442433810175333 1 62 105 1"
random.seed 5
repeat 4 { () midi.scale C4 | midi.walk 4 } | each { (ks) midi.seq $ks 0.25 } | midi.sequence | each { (n) midi.field $n 4 } | join , | equals 60,60,62,64,60,62,64,65,60,60,60,62,60,60,62,60
# chance keeps the length; other kinds pass through.
midi.cc 7 1 | midi.stack $(midi.seq "C4 D4") | midi.chance 0 | join , | equals "cc 0 7 1 1,rest 0 1,rest 1 1"
midi.seq "C4 D4" | midi.chance 1 | join , | equals "note 0 1 60 100 1,note 1 1 62 100 1"

# Files keep every kind and the trailing rest.
midi.seq "C4 ." 0.5 | midi.stack $(midi.program 5) | midi.write $(tmp a.mid) 100 | midi.read | join , | equals "tempo 0 100,program 0 5 1,note 0 0.5 60 100 1,rest 0.5 0.5"
# Outputs get mode 0666 less the umask, as a new shell file does. CTest
# runs this under umask 027.
def same-mode { (f) out-dir | path-join umask-ref | with { (r) run sh -c 'rm -f "$2"; : > "$2"; ls -l "$1" "$2" | cut -c1-10 | uniq | wc -l' sh $f $r } | trim | check { equals 1 } "the output's mode ignored the umask" } "Fail unless F has a new file's mode"
tmp a.mid | same-mode
