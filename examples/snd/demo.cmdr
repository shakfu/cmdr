#!/usr/bin/env cmdr
# Sox in cmdr: build chains, combine and split files, and inspect results.
#
#   build/cmdr examples/snd/demo.cmdr    # built with -DCMDR_SND=ON
#
# Files go in SND_OUT (default snd-out/ in the current directory). Nothing
# plays; snd.play CHAIN would send a chain to the default audio device.

import snd
import env
import fs

env.or SND_OUT snd-out | fs.mkdir | as out-dir "The output directory"
def at { (p) out-dir | path-join $p } "Path P in the output directory"
def write-to { (chain p) snd.out $chain $(at $p) } "Run CHAIN into P in the output directory; return the path"
def report { (ps) lines $ps | each { (p) list $(path-basename $p) $(snd.info $p | head 3 | rest | unwords) | unwords } } "One line per path in PS, a path or a list: the file name, rate, and channels"

# 1. Synthesize two tones. A chain is a list of sox's arguments until out runs it.
# as names a file for later steps.
snd.tone 2 440 | unwords
snd.tone 2 440 | write-to a440.wav | as a440
snd.tone 2 330 | write-to e330.wav | as e330
list a440.wav e330.wav | each { at } | as tones
tones | report

# 2. Effects, named or as sox writes them.
a440 | snd.in | snd.rate 48000 | snd.fade 0.1 0.5 | snd.effect "chorus 0.7 0.9 55 0.4 0.25 2 -t" | write-to chorus.wav | report

# 3. Combine: mix into a chord, merge into stereo, join end to end.
tones | snd.mix | write-to chord.wav | as chord
chord | report
tones | snd.merge | write-to stereo.wav | as stereo
stereo | report
tones | snd.join | snd.stats-field "Length s"

# 4. Presets are definitions from chain to chain.
stereo | snd.in | snd.telephone | write-to telephone.wav | report
chord | snd.in | snd.tape-stop | write-to tape-stop.wav | snd.info-field seconds

# 5. Split: at times, at silences, and by channel.
a440 | snd.in | snd.split-at "0.5 1" $(at cut.wav) | report
at note.wav | with { (o) e330 | snd.in | snd.trim 0 0.4 | snd.pad 0 0.6 | snd.repeat 2 | snd.split-silence -40 0.3 $o } | report
stereo | snd.in | snd.split-channels $(at voice.wav) | report

# 6. sox's stats for any chain, with no file written.
chord | snd.in | snd.stats | lines | head 4
