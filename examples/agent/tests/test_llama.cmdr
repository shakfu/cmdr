# Checks the llama agent with tests/stubs/curl on PATH, which saves each
# request and returns a canned reply. CTest runs it as example_agent_llama.

import agent
import fs
import json
import shlex

agent.runs-dir | fs.mkdir | path-join llama-project | as project "A git copy of sample/"
def git-in { (d args) agent.git-in $d $(list -c user.name=t -c user.email=t@example.invalid $args) }
def request { () agent.runs-dir | path-join llama-request.json | read } "The last request body"
def requests { () agent.runs-dir | path-join llama-requests.log | try { read | lines | count } 0 } "Requests sent so far"
def reset { () project | with { (d) list "checkout -q -- ." "clean -fdq" | each { (c) git-in $d $(shlex.split $c) } } } "Undo edits to the copy"
def stats { () project | path-join stats.py | read }
def edit-fails { (q) project | agent.target-path | try { (t) agent.edit $t llama $q } rejected | check { equals rejected } "a bad edit was accepted" } "Fail unless edit Q is rejected"
def stages { () agent.runs-dir | fs.dirs | keep { matches 'llama-stage-' } | count } "Staging copies left in AW_RUNS"
def absent { (p) try { () fs.exists $p | $p } absent | check { equals absent } "a file was written outside the project" }

project | with { (d) or { () fs.exists $d | fs.remove-tree } "" | with { (_) script-dir | path-join ../sample | fs.copy $d } }
project | with { (d) list "init -q" "add -A" "commit -q -m sample" | each { (c) git-in $d $(shlex.split $c) } }

# ask sends every tracked file and returns the reply without applying it.
project | agent.target-path | agent.ask llama "Where is mean?" | check { contains "off by one" } "ask did not return the reply"
request | check { contains "def mean" } "the request lacked the project files"
request | check { contains "You cannot run commands." } "the request did not say llama cannot run commands"
stats | check { contains "(len(xs) - 1)" } "ask changed a file"

# edit applies the reply's edit block, sends MODEL, and deletes its staging copy.
stages | with { (n) project | agent.target-path | agent.edit llama:qwen "Fix mean." | check { contains "off by one" } "edit did not return the reply" | $n | with { (k) stages | sub $k } | check { equals 0 } "a staging copy was left after its edits applied" }
request | json.text model | check { equals qwen } "the request lacked the model"
request | json.text messages 0 content | check { contains "Fix mean." } "the request lacked the prompt"
request | check { contains "<<<<<<< SEARCH" } "the request did not describe edit blocks"
stats | check { contains "return sum(xs) / len(xs)\n" } "edit did not apply the block"

# Blocks apply in order, may create files, and may mark paths up as Markdown.
reset
project | agent.target-path | agent.edit llama "MULTI"
stats | check { contains "return sum(xs) / float(len(xs))\n" } "a second block on a file did not see the first"
project | path-join tests/test_mean.py | read | check { equals "from stats import mean\n" } "an empty SEARCH did not create the file"

# A block without a path line edits the previous block's file.
reset
project | agent.target-path | agent.edit llama "INHERIT"
stats | check { contains "\"\"\"Return the mean of xs.\"\"\"\n    return sum(xs) / len(xs)\n" } "a block without a path did not edit the previous file"

# A block without a path edits the one tracked file holding its SEARCH lines.
# Prose where the path belongs is not read as a path.
reset
project | agent.target-path | agent.edit llama "NOPATH"
project | path-join test_stats.py | read | check { contains "from stats import mean, median\n" } "a block without a path did not edit the file holding SEARCH"
reset
project | agent.target-path | agent.edit llama "PROSE"
stats | check { contains "return sum(xs) / len(xs)\n" } "prose was read as a path"
reset
edit-fails ORPHAN
request | check { contains "no file path before SEARCH" } "a block without a path or a matching file was not explained"

# An edit to a missing file says so.
edit-fails MISSING
request | check { contains "no such file: stats_test.py" } "a missing file was not named as missing"

# A block whose SEARCH matches nothing is retried once, with the reason.
reset
project | agent.target-path | agent.edit llama "BADFIRST" | check { contains "off by one" } "the retry's reply was not returned"
request | check { contains "SEARCH must match exactly one place in stats.py" } "the retry lacked the reason"
stats | check { contains "return sum(xs) / len(xs)\n" } "the retry's block was not applied"

# A second failure fails the step after exactly two requests.
reset
requests | with { (n) edit-fails ALWAYSBAD | $n | with { (k) requests | sub $k } | check { equals 2 } "a bad edit was not retried exactly once" }
stats | check { contains "(len(xs) - 1)" } "a rejected edit changed a file"

# One bad block leaves every file unchanged.
reset
edit-fails PARTIAL
stats | check { contains "(len(xs) - 1)" } "a partly bad reply changed a file"

# No edit leaves the project: not by .., not into .git, not through a link.
edit-fails ESCAPE
agent.runs-dir | path-join escape.txt | absent
edit-fails GITDIR
project | path-join .git/hooks/pre-commit | absent
project | with { (d) fs.symlink $(agent.runs-dir) $(path-join $d link) }
edit-fails LINK
agent.runs-dir | path-join escape.txt | absent
project | path-join link | fs.remove

# .git is rejected in any case, since APFS and NTFS ignore case.
list .GIT/hooks/pre-commit .Git/config | each { (p) project | try { (d) agent.edit-safe $d $p | text accepted } rejected | check { equals rejected } "a .git path in another case was accepted" }

# A rejected path is never read. A writer on each FIFO marks each open and
# serves readers for 10 seconds, so a regression fails rather than hangs.
def fifo-watch { (f m) run mkfifo $f | with { (_) run sh -c 'while [ -p "$1" ]; do { : > "$2"; echo x; } > "$1"; done </dev/null >/dev/null 2>&1 & p=$!; { sleep 10; kill $p; } </dev/null >/dev/null 2>&1 &' sh $f $m } } "Make FIFO F; touch M once a reader opens it"
def fifo-stage { (p) project | with { (d) agent.runs-dir | path-join llama-fifo-stage | with { (st) format "{}\n<<<<<<< SEARCH\nx\n=======\ny\n" $p | with { (c) agent.edit-stage $d $st $c } } } } "Stage an edit block for P; return why it failed"
list .git/fifo fifo | each { (p) project | path-join $p | with { (f) concat $f .opened | with { (m) fifo-watch $f $m | with { (_) fifo-stage $p } | check { matches "^unsafe path" } "an edit to a FIFO was not rejected as unsafe" | with { (_) try { () fs.exists $m | text read } unread } | check { equals unread } "a rejected path was read" | with { (_) run rm $f } } } }

# A block without a path whose SEARCH is in two files edits neither. Last,
# since it commits a copy of stats.py.
project | with { (d) path-join $d stats.py | read | write $(path-join $d stats_copy.py) | $d | with { (y) list "add -A" "commit -q -m copy" | each { (c) git-in $y $(shlex.split $c) } } }
edit-fails AMBIG
request | check { contains "no file path before SEARCH" } "an ambiguous block was not explained"
stats | check { contains "(len(xs) - 1)" } "an ambiguous block changed stats.py"

# A repository's own config runs no command, and no file is read through a
# link: not a committed link, and not a tracked file replaced by one.
agent.runs-dir | path-join llama-evil | as evil
agent.runs-dir | path-join llama-secret.txt | as secret
agent.runs-dir | path-join llama-pwned | as pwned
list $evil $pwned | each { (p) or { () fs.exists $p | fs.remove-tree } "" }
fs.mkdir $evil | path-join a.txt | with { (a) text hi | write $a }
evil | path-join plain.md | with { (p) text plain | write $p }
text SECRET-A1 | write $secret
fs.symlink $secret $(path-join $evil notes.md)
list "init -q" "add -A" "commit -q -m evil" | each { (c) git-in $evil $(shlex.split $c) }
path-join $evil plain.md | fs.remove | with { (p) fs.symlink $secret $p }
format "touch '{}'; false" $pwned | with { (cmd) git-in $evil $(list config core.fsmonitor $cmd) }
agent.llama-context $evil | check { contains "### a.txt" } "llama-context lost a.txt" | check { not { contains SECRET-A1 } } "llama-context read through a link"
try { () agent.edit-infer $evil SECRET-A1 } none | check { equals none } "edit-infer read through a link"
try { () fs.exists $pwned | text ran } "did not run" | check { equals "did not run" } "git ran the repository's core.fsmonitor"
