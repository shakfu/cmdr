#!/usr/bin/env cmdr
# Command-line entry point for the agent module. Run without arguments for usage.

import agent

def cli-id { (a) count $a | check { equals 2 } $agent.cli-usage | $a | nth 2 } "The one ID in ARGS"
def main-start { (a) agent.start $(rest $a) }
def main-status { (a) agent.status $(rest $a) }
def main-log { (a) agent.log $(cli-id $a) }
def main-result { (a) agent.result $(cli-id $a) }
def main-cancel { (a) agent.cancel $(cli-id $a) }
def main-wait { (a) agent.cli-args $a 2 | rest | agent.wait | unlines }
list start status log result cancel wait | as run-commands "Commands on detached runs"

script-args | agent.cli-args 1 | with { (a) first $a | if { (c) run-commands | any { equals $c } } { (c) list $a | map $(concat main- $c) | concat } else { (_) agent.cli $a } }
